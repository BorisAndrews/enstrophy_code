+class _IdentityInliner(MultiFunction):
+    """Replace ``I[i, j]``, both indices fixed, by the Kronecker delta."""
+
+    expr = MultiFunction.reuse_if_untouched
+
+    def multi_index(self, o):
+        return o
+
+    def indexed(self, o, child, multiindex):
+        from ufl.classes import Identity
+        from ufl.constantvalue import IntValue
+        if isinstance(child, Identity):
+            indices = multiindex.indices()
+            if len(indices) == 2 and all(isinstance(i, FixedIndex) for i in indices):
+                i, j = (int(k) for k in indices)
+                return IntValue(1) if i == j else Zero()
+        return self.expr(o, child, multiindex)
+
+
+def drop_zero_blocks(a):
+    """Simplify a form so that structurally-zero mixed sub-blocks vanish.
+
+    When a sub-block is extracted from a mixed form and its arguments are
+    replaced by ones on the collapsed sub-space -- as the matrix-free operators
+    and the assembled preconditioners do -- the components that were zeroed out
+    survive as ``I[i, j] * grad(v)`` products that UFL never folds away. That is
+    harmless for a single-mesh form, but on a mixed space spanning several
+    meshes it leaves an integral over one mesh syntactically referring to an
+    argument on another, which the form compiler rejects with a
+    ``MismatchingDomainError``. Folding the fixed-index identities turns those
+    terms into literal zeros, and the zero integrals are then dropped.
+
+    Only forms spanning more than one mesh are touched; everything else is
+    returned unchanged.
+    """
+    from ufl import Form
+    from ufl.algorithms import expand_derivatives
+    from ufl.algorithms.remove_component_tensors import remove_component_tensors
+    from ufl.domain import extract_domains
+
+    if not isinstance(a, Form) or len(extract_domains(a)) < 2:
+        return a
+    return map_integrand_dags(_IdentityInliner(),
+                              remove_component_tensors(expand_derivatives(a)))
